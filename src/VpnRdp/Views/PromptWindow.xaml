<Window x:Class="VpnRdp.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN sign-in" SizeToContent="Height" Width="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Topmost="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="Firebrick" Margin="0,0,0,10" Visibility="Collapsed" />

        <StackPanel x:Name="UserPanel">
            <TextBlock Text="Username" />
            <TextBox x:Name="UserBox" />
        </StackPanel>

        <TextBlock x:Name="SecretLabel" Text="Password" />
        <PasswordBox x:Name="SecretBox" />
        <TextBox x:Name="SecretPlainBox" Visibility="Collapsed" />

        <CheckBox x:Name="SaveBox" Content="Save password (Windows Credential Manager)" IsChecked="True" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Connect" IsDefault="True" Click="Ok_Click" x:Name="OkButton" />
            <Button Content="Cancel" IsCancel="True" Margin="0,0,0,6" />
        </StackPanel>
    </StackPanel>
</Window>
