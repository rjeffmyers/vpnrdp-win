<Window x:Class="VpnRdp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN+RDP Manager" Width="880" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Import .ovpn file..." Click="Import_Click" />
                <MenuItem Header="_New profile..." Click="New_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Setup OpenVPN..." Click="Setup_Click" />
                <MenuItem Header="Show _mstsc monitor IDs" Click="MonitorIds_Click" />
                <MenuItem Header="Open _log folder" Click="Logs_Click" />
                <Separator />
                <MenuItem x:Name="StartWithWindowsItem" Header="Start with _Windows" IsCheckable="True" Click="StartWithWindows_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- OpenVPN status banner -->
        <Border DockPanel.Dock="Top" Padding="10,6" Background="#FFF4E5" BorderBrush="#F0C080" BorderThickness="0,0,0,1"
                Visibility="{Binding SetupNeeded, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Setup..." Click="Setup_Click" Margin="8,0,0,0" />
                <TextBlock Text="{Binding OpenVpnStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding OpenVpnStatus}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Profile list -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Import .ovpn" Click="Import_Click" />
                    <Button Content="New" Click="New_Click" MinWidth="50" />
                </StackPanel>
                <ListBox x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}"
                         MouseDoubleClick="ProfileList_DoubleClick" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="Gray" FontSize="11" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- Empty state -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                        Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="No connections yet" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                           Text="Import the .ovpn file from your VPN administrator, then add the Remote Desktop computer you want to open once connected." />
                <Button Content="Import .ovpn file..." Click="Import_Click" HorizontalAlignment="Left" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Details -->
            <Grid Grid.Column="2" DataContext="{Binding Selected}"
                  Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                    <Button Content="Connect + RDP" Click="ConnectRdp_Click" FontWeight="SemiBold" />
                    <Button Content="Connect VPN" Click="Connect_Click" />
                    <Button Content="Open RDP" Click="Rdp_Click" />
                    <Button Content="Disconnect" Click="Disconnect_Click" />
                    <Button Content="Edit..." Click="Edit_Click" />
                    <Button Content="Delete" Click="Delete_Click" />
                </WrapPanel>

                <GroupBox Grid.Row="2" Header="Traffic">
                    <StackPanel>
                        <Border BorderBrush="#DDD" BorderThickness="1" Height="54" Width="304" HorizontalAlignment="Left" Background="#FAFAFA">
                            <Canvas Width="300" Height="50">
                                <Polyline Points="{Binding InSparkline}" Stroke="SeaGreen" StrokeThickness="1.5" />
                                <Polyline Points="{Binding OutSparkline}" Stroke="SteelBlue" StrokeThickness="1.5" />
                            </Canvas>
                        </Border>
                        <TextBlock Text="{Binding TrafficText}" Margin="0,4,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="3" Header="Log">
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11"
                             BorderThickness="0" />
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
