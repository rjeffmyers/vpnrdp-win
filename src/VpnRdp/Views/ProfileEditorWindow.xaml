<Window x:Class="VpnRdp.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:VpnRdp.Views"
        Title="Connection profile" Width="640" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" Margin="0,0,0,6" />
        </StackPanel>

        <TabControl>
            <!-- ================= VPN ================= -->
            <TabItem Header="VPN">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Profile name" />
                        <TextBox Grid.Column="1" Text="{Binding Name}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="OpenVPN config" />
                        <DockPanel Grid.Row="1" Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseOvpn_Click" Margin="6,0,0,6" MinWidth="0" />
                            <TextBox x:Name="OvpnBox" Text="{Binding OvpnPath}" IsReadOnly="True" />
                        </DockPanel>

                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OvpnInfoText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="VPN username" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding VpnUsername}" />

                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="VPN password" />
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <ComboBox ItemsSource="{x:Static v:EditorOptions.SecretModes}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                      SelectedValue="{Binding VpnPasswordMode}" />
                            <PasswordBox x:Name="VpnPasswordBox" />
                            <TextBlock x:Name="VpnPasswordHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>

                        <GroupBox Grid.Row="5" Grid.ColumnSpan="2" Header="After connecting" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox Content="This profile has a Remote Desktop target (see RDP tab)" IsChecked="{Binding RdpEnabled}" />
                                <CheckBox Content="Open Remote Desktop automatically when the VPN connects" IsChecked="{Binding AutoRdpAfterConnect}" Margin="20,3,0,3" />
                                <CheckBox Content="Disconnect the VPN when the Remote Desktop window is closed" IsChecked="{Binding DisconnectVpnWhenRdpCloses}" Margin="20,3,0,3" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= RDP ================= -->
            <TabItem Header="Remote Desktop" DataContext="{Binding Rdp}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Computer (host or IP)" />
                        <TextBox Grid.Column="1" Text="{Binding Host}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Port" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port}" Width="80" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Username" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Username}" />

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Domain (optional)" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Domain}" />

                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Password" />
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <ComboBox ItemsSource="{x:Static v:EditorOptions.SecretModes}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                      SelectedValue="{Binding PasswordMode}" />
                            <PasswordBox x:Name="RdpPasswordBox" />
                            <TextBlock x:Name="RdpPasswordHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="The RDP password is stored as TERMSRV/&lt;host&gt; in Windows Credential Manager, where Remote Desktop Connection (mstsc) reads it directly — it is never passed on a command line." />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Display ================= -->
            <TabItem Header="Display" DataContext="{Binding Rdp}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Window">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Mode" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static v:EditorOptions.DisplayModes}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding DisplayMode}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Size (windowed / single)" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Width}" Width="70" />
                                    <TextBlock Text=" × " VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Height}" Width="70" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Scaling" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static v:EditorOptions.ScaleFactors}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding DesktopScaleFactor}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Colors" />
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static v:EditorOptions.ColorDepths}" SelectedItem="{Binding ColorDepth}"
                                          ItemStringFormat="{}{0}-bit" Width="100" HorizontalAlignment="Left" />
                            </Grid>
                        </GroupBox>
                        <CheckBox Content="Dynamic resolution (resize the remote desktop with the window)" IsChecked="{Binding DynamicResolution}" />
                        <CheckBox Content="Smart sizing (scale instead of scrollbars)" IsChecked="{Binding SmartSizing}" />
                        <CheckBox Content="Show the connection bar in full screen" IsChecked="{Binding ShowConnectionBar}" />

                        <GroupBox Header="Monitors" Margin="0,10,0,0">
                            <StackPanel>
                                <ComboBox x:Name="MonitorModeBox" ItemsSource="{x:Static v:EditorOptions.MonitorModes}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding MonitorMode}" SelectionChanged="MonitorMode_Changed" />
                                <TextBlock x:Name="MonitorHelp" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <Border BorderBrush="#CCC" BorderThickness="1" Background="#F4F4F4" Height="170">
                                    <Canvas x:Name="MonitorCanvas" Margin="8" SizeChanged="MonitorCanvas_SizeChanged" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Identify" Click="Identify_Click" />
                                    <Button Content="Show mstsc IDs" Click="MstscIds_Click" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Local resources / experience ================= -->
            <TabItem Header="Resources" DataContext="{Binding Rdp}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Local resources">
                            <StackPanel>
                                <TextBlock Text="Remote audio" />
                                <ComboBox ItemsSource="{x:Static v:EditorOptions.AudioModes}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Audio}" />
                                <CheckBox Content="Microphone" IsChecked="{Binding Microphone}" />
                                <CheckBox Content="Clipboard" IsChecked="{Binding Clipboard}" />
                                <CheckBox Content="Printers" IsChecked="{Binding Printers}" />
                                <CheckBox Content="Local drives" IsChecked="{Binding Drives}" />
                                <CheckBox Content="Smart cards" IsChecked="{Binding SmartCards}" />
                                <TextBlock Text="Apply Windows key combinations" Margin="0,8,0,0" />
                                <ComboBox ItemsSource="{x:Static v:EditorOptions.KeyboardHooks}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding KeyboardHook}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Experience">
                            <StackPanel>
                                <ComboBox ItemsSource="{x:Static v:EditorOptions.Speeds}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Speed}" />
                                <CheckBox Content="Desktop background" IsChecked="{Binding Wallpaper}" />
                                <CheckBox Content="Font smoothing" IsChecked="{Binding FontSmoothing}" />
                                <CheckBox Content="Desktop composition" IsChecked="{Binding DesktopComposition}" />
                                <CheckBox Content="Persistent bitmap caching" IsChecked="{Binding BitmapCaching}" />
                                <CheckBox Content="Reconnect if the connection is dropped" IsChecked="{Binding AutoReconnect}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Advanced ================= -->
            <TabItem Header="Advanced" DataContext="{Binding Rdp}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <CheckBox Content="Connect to the administrative (console) session" IsChecked="{Binding AdminSession}" />
                        <TextBlock Text="If server authentication fails" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{x:Static v:EditorOptions.AuthLevels}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                  SelectedValue="{Binding AuthenticationLevel}" />
                        <TextBlock Text="RD Gateway server (optional)" />
                        <TextBox Text="{Binding GatewayHost}" />
                        <TextBlock Text="Extra .rdp settings (one per line, name:type:value — overrides everything above)" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ExtraLines}" AcceptsReturn="True" Height="120" FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                        <Button Content="Preview .rdp file" Click="Preview_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
